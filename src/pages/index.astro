---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) =>
  import.meta.env.DEV || !data.draft
);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="Gaston Guitart"
  description="Notes on processing large amounts of data in a distributed, modern way, with companion code in a variety of languages and tools"
>
  <h1>Gaston Guitart</h1>
  <p class="lead">
    I write about building and operating distributed data systems from the point of view of a heavily SWE-oriented Data Engineer. About the
    design decisions, trade-offs, and different ways to tackle problems. Posts come
    with runnable code.
  </p>

  <h2>Recent writing</h2>
  {recentPosts.length === 0 ? (
    <p><em>Nothing published yet, first post coming soon.</em></p>
  ) : (
    <ul class="post-list">
      {recentPosts.map((post) => (
        <li>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <a class="post-link" href={`/blog/${post.id}/`}>{post.data.title}</a>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}

  {allPosts.length > 5 && <p><a href="/blog">All posts &rarr;</a></p>}
</BaseLayout>
