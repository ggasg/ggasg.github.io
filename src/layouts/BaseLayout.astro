---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  ogType?: 'website' | 'article';
  ogImage?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  ogType = 'website',
  ogImage,
} = Astro.props;

const siteName = 'Gaston Guitart';
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Social networks need an absolute URL, and they fetch the image without
// following the page, so a relative path silently yields no preview.
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : null;

// Sign up at https://www.goatcounter.com, create a site, and replace this
// with the code it gives you (the part before ".goatcounter.com"). Only
// loads on the production build, never in `astro dev`.
const GOATCOUNTER_CODE = 'ggasgg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={new URL('rss.xml', Astro.site)}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {ogImageURL && (
      <>
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="2400" />
        <meta property="og:image:height" content="1254" />
        <meta property="og:image:alt" content={description} />
      </>
    )}

    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <meta name="generator" content={Astro.generator} />

    {import.meta.env.PROD && GOATCOUNTER_CODE !== 'YOUR-CODE' && (
      <script
        is:inline
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
        async
        src="//gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="brand" href="/">Gaston GG</a>
        <a href="/blog">Writing</a>
        <a href="/about">About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <nav>
        <a href="https://github.com/ggasg" rel="me noopener noreferrer" target="_blank">GitHub</a>
        <a href="https://dev.to/ggasg" rel="me noopener noreferrer" target="_blank">dev.to</a>
        <span>&copy; {new Date().getFullYear()} Gaston Guitart</span>
      </nav>
    </footer>

    <script>
      // Give every fenced code block the header bar and copy button that
      // the GitHub snippet component already has. Built by script rather
      // than by a markdown plugin so a block that predates this, or a
      // reader with scripting off, still gets a readable <pre>.
      for (const pre of document.querySelectorAll('pre[data-language]')) {
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        const header = document.createElement('div');
        header.className = 'code-block-header';

        const lang = document.createElement('span');
        lang.textContent = pre.dataset.language ?? '';

        const button = document.createElement('button');
        button.className = 'copy-button';
        button.type = 'button';
        button.textContent = 'Copy';
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText);
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Press Ctrl+C';
          }
          setTimeout(() => (button.textContent = 'Copy'), 1600);
        });

        header.append(lang, button);
        pre.replaceWith(wrapper);
        wrapper.append(header, pre);
      }
    </script>
  </body>
</html>
